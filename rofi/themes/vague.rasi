* {
    black:       #141415;
    charcoal:    #252530;
    gray:        #878787;
    white:       #cdcdcd;
    transparent: rgba(20, 20, 21, 0.8);

    background-color: transparent;
    text-color: @white;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    background-color: @transparent;
    border: 1px;
    border-color: rgba(205, 205, 205, 0.15);
    border-radius: 0px;
    padding: 0px;
    width: 40%;
    y-offset: 12%;
}

mainbox {
    background-color: transparent;
    spacing: 0px;
}

inputbar {
    background-color: transparent;
    padding: 8px 10px;
    spacing: 6px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @gray;
}

entry {
    text-color: @white;
    placeholder-color: @gray;
    placeholder: "Search...";
}

listview {
    background-color: transparent;
    lines: 10;
    spacing: 0px;
    padding: 0px;
}

element {
    background-color: transparent;
    text-color: @gray;
    padding: 6px 10px;
}

element selected {
    background-color: @charcoal;
    text-color: @white;
}

element-icon {
    size: 1.1em;
}

element-text {
    text-color: inherit;
}
