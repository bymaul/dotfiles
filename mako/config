font=JetBrainsMono Nerd Font Mono 10
background-color=#141415b3
text-color=#cdcdcd
border-color=#cdcdcd66
border-size=1
border-radius=0
width=300
height=90
padding=8
margin=8
max-visible=5
default-timeout=5000
icons=1
icon-path=/usr/share/icons/Adwaita
layer=overlay
anchor=top-right
group-by=app-name
sort=-time

on-button-left=dismiss
on-button-middle=exec makoctl menu -n "$id" -- rofi -dmenu -p "Action:"

[app-name=volume]
progress-color=over #cdcdcd33

[app-name=volume summary~="Muted"]
border-color=#d8647e

[app-name=brightness]
progress-color=over #cdcdcd33

[actionable]
on-button-left=invoke-default-action
border-color=#7e98e8

[mode=dnd]
invisible=1

[mode=dnd app-name=dnd]
invisible=0
