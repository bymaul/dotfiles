pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import "SettingsUtil.js" as U

Singleton {
    id: monitors

    readonly property string monitorsLuaFile: {
        const xdg = Quickshell.env("XDG_DATA_HOME") ?? "";
        const home = Quickshell.env("HOME") ?? "";
        if (xdg !== "")
            return xdg + "/quickshell/qs-monitors.lua";
        if (home !== "")
            return home + "/.local/share/quickshell/qs-monitors.lua";
        return "";
    }

    function monitorsLua(): string {
        const lines = ["-- Generated by quickshell display settings. Do not edit manually."];
        for (const name of Object.keys(monitors.monitorConfigs))
            lines.push(monitors.monitorRuleCode(name));
        return lines.join("\n") + "\n";
    }

    property var monitors: []
    property var monitorConfigs: ({})
    property string mainMonitor: "auto"
    property bool monitorsReady: false
    property var appliedMonitors: []
    property string lastApplyMsg: ""
    property var applyQueue: []
    property double lastMonScan: 0

    function applyLoaded(obj): void {
        if (!obj || typeof obj !== "object")
            return;
        monitors.mainMonitor = U.pickStr(obj.mainMonitor, "auto");
        if (obj.monitorConfigs && typeof obj.monitorConfigs === "object") {
            const clean = {};
            for (const name of Object.keys(obj.monitorConfigs)) {
                if (typeof name !== "string" || name === "" || name.length > 64)
                    continue;
                if (!/^[A-Za-z0-9._-]+$/.test(name))
                    continue;
                const e = obj.monitorConfigs[name];
                if (!e || typeof e !== "object")
                    continue;
                const entry = {};
                if (typeof e.enabled === "boolean")
                    entry.enabled = e.enabled;
                if (typeof e.scale === "number" && !isNaN(e.scale))
                    entry.scale = Math.max(0.5, Math.min(3, e.scale));
                if (typeof e.res === "string" && e.res !== "") {
                    const r = e.res.slice(0, 64);
                    if (r === "preferred" || U.parseMode(r).valid)
                        entry.res = r;
                }
                if (typeof e.pos === "string" && U.isValidMonitorPos(e.pos))
                    entry.pos = e.pos.slice(0, 64);
                clean[name] = entry;
            }
            monitors.monitorConfigs = clean;
        }
    }

    function applyScannedMonitors(): void {
        if (!monitors.monitorsReady || !Settings.loaded)
            return;
        monitors.migrateKeywordPositions();
        const pending = Object.keys(monitors.monitorConfigs).filter(name => !monitors.appliedMonitors.includes(name) && monitors.monitorLive(name) !== null);
        if (pending.length === 0)
            return;
        pending.sort((a, b) => {
            const la = monitors.monitorLive(a) ?? {};
            const lb = monitors.monitorLive(b) ?? {};
            return (la.x ?? 0) - (lb.x ?? 0) || (la.y ?? 0) - (lb.y ?? 0);
        });
        const targets = [];
        for (const name of pending) {
            if (!monitors.monitorEnabled(name) && !monitors.canDisableMonitor(name)) {
                monitors.putMonitorCfg(name, {enabled: true});
                monitors.lastApplyMsg = name + " kept enabled (only display)";
                Settings.scheduleSave();
            }
            monitors.appliedMonitors = [...monitors.appliedMonitors, name];
            targets.push(name);
        }
        monitors.applyBatched(targets.map(n => monitors.monitorRuleDesc(n)).join(", "), targets.map(n => monitors.monitorRuleCode(n)), true, targets);
    }
    function migrateKeywordPositions(): void {
        if (!monitors.monitorsReady || !Settings.loaded)
            return;
        const live = monitors.monitors.filter(m => m && typeof m.name === "string" && m.name !== "" && monitors.monitorEnabled(m.name));
        if (live.length === 0)
            return;
        let stale = false;
        let axis = "row";
        for (const m of live) {
            const p = monitors.monitorPos(m.name);
            if (p !== "auto" && !U.isExplicitPos(p))
                stale = true;
            if (p === "auto-down" || p === "auto-up")
                axis = "column";
        }
        if (!stale)
            return;
        const byAxis = axis === "column" ? (a, b) => (a.y ?? 0) - (b.y ?? 0) : (a, b) => (a.x ?? 0) - (b.x ?? 0);
        const ordered = live.slice().sort(byAxis).map(m => String(m.name));
        const map = monitors.layoutCoords(ordered, axis);
        for (const n of Object.keys(map))
            monitors.putMonitorCfg(n, {pos: map[n]});
        Settings.scheduleSave();
    }

    function refreshMonitors(force: bool): void {
        if (monitorScan.running)
            return;
        if (!force && Date.now() - monitors.lastMonScan < 30000)
            return;
        monitors.lastMonScan = Date.now();
        monitorScan.running = true;
    }
    function monitorCfg(name: string): var {
        return monitors.monitorConfigs[name] ?? {};
    }
    function monitorLive(name: string): var {
        return monitors.monitors.find(m => m && m.name === name) ?? null;
    }
    function monitorEnabled(name: string): bool {
        const cfg = monitors.monitorCfg(name);
        if (typeof cfg.enabled === "boolean")
            return cfg.enabled;
        const live = monitors.monitorLive(name);
        return live ? live.disabled !== true : true;
    }
    function enabledMonitors(): var {
        return monitors.monitors.filter(m => m && monitors.monitorEnabled(m.name));
    }
    function canDisableMonitor(name: string): bool {
        if (!monitors.monitorsReady)
            return false;
        const enabled = monitors.enabledMonitors();
        if (enabled.length === 0)
            return true;
        if (enabled.length > 1)
            return true;
        return enabled[0].name !== name;
    }
    function monitorScale(name: string): real {
        const cfg = monitors.monitorCfg(name);
        if (typeof cfg.scale === "number" && !isNaN(cfg.scale))
            return Math.max(0.5, Math.min(3, cfg.scale));
        const live = monitors.monitorLive(name);
        return live && typeof live.scale === "number" ? live.scale : 1;
    }
    function monitorModes(name: string): var {
        const modes = ["preferred"];
        const live = monitors.monitorLive(name);
        if (live && Array.isArray(live.availableModes)) {
            for (const m of live.availableModes) {
                if (typeof m === "string" && m !== "" && !modes.includes(m))
                    modes.push(m);
            }
        }
        return U.dedupeSortModes(modes);
    }
    function monitorResolutions(name: string): var {
        return ["Preferred"].concat(U.resolutionsFor(monitors.monitorModes(name)));
    }
    function monitorResKey(name: string): string {
        const cfg = monitors.monitorCfg(name);
        if (typeof cfg.res === "string" && cfg.res !== "" && cfg.res !== "preferred")
            return U.resKeyOf(cfg.res);
        return "Preferred";
    }
    function monitorDetails(name: string): string {
        return U.monitorDetails(monitors.monitorLive(name));
    }
    function monitorRes(name: string): string {
        const cfg = monitors.monitorCfg(name);
        if (typeof cfg.res === "string" && cfg.res !== "")
            return cfg.res;
        const live = monitors.monitorLive(name);
        if (live && typeof live.width === "number" && typeof live.height === "number") {
            if (typeof live.refreshRate === "number")
                return live.width + "x" + live.height + "@" + live.refreshRate.toFixed(2) + "Hz";
            return live.width + "x" + live.height;
        }
        return "preferred";
    }
    function monitorSummary(name: string): string {
        const live = monitors.monitorLive(name);
        if (!live || typeof live.width !== "number" || typeof live.height !== "number")
            return name;
        const rate = typeof live.refreshRate === "number" ? live.refreshRate.toFixed(2) : "?";
        let s = name + "  " + live.width + "x" + live.height + "@" + rate + "  x" + monitors.monitorScale(name).toFixed(2).replace(/\.?0+$/, "");
        const pos = monitors.monitorPos(name);
        if (pos !== "auto" && monitors.enabledMonitors().length > 1)
            s += "  " + U.posLabel(pos);
        if (!monitors.monitorEnabled(name) || live.disabled === true)
            s += "  (disabled)";
        else if (!monitors.canDisableMonitor(name))
            s += "  (last display)";
        return s;
    }
    function validMonitorName(name: string): bool {
        return typeof name === "string" && name !== "" && name.length <= 64 && /^[A-Za-z0-9._-]+$/.test(name);
    }
    function monitorRuleCode(name: string): string {
        if (!monitors.validMonitorName(name))
            return "-- invalid monitor skipped: " + name.slice(0, 32);
        if (!monitors.monitorEnabled(name))
            return 'hl.monitor({output = ' + HyprBridge.luaStr(name) + ', disabled = true})';
        const scale = HyprBridge.luaVal(String(monitors.monitorScale(name)));
        let res = String(monitors.monitorRes(name));
        if (res !== "preferred" && !U.parseMode(res).valid)
            res = "preferred";
        let pos = monitors.monitorPos(name);
        if (!U.isValidMonitorPos(pos))
            pos = "auto";
        return 'hl.monitor({output = ' + HyprBridge.luaStr(name) + ', disabled = false, mode = ' + HyprBridge.luaStr(res) + ', position = ' + HyprBridge.luaStr(pos) + ', scale = ' + scale + '})';
    }
    function monitorRuleDesc(name: string): string {
        if (!monitors.monitorEnabled(name))
            return name + " disabled";
        const pos = monitors.monitorPos(name);
        return name + " -> " + String(monitors.monitorRes(name)) + " x" + String(monitors.monitorScale(name)) + (pos !== "auto" ? " " + pos : "");
    }
    function applyMonitor(name: string, quiet: bool, force: bool): void {
        const q = !!quiet;
        if (!monitors.validMonitorName(name))
            return;
        const live = monitors.monitorLive(name);
        if (!force && live && monitors.monitorInSync(name, live)) {
            monitors.lastApplyMsg = name + " already in sync";
            return;
        }
        if (!q && !monitors.appliedMonitors.includes(name))
            monitors.appliedMonitors = [...monitors.appliedMonitors, name];
        if (!monitors.monitorEnabled(name)) {
            if (!monitors.canDisableMonitor(name)) {
                monitors.putMonitorCfg(name, {enabled: true});
                monitors.lastApplyMsg = name + " kept enabled (only display)";
                Settings.scheduleSave();
                return;
            }
            monitors.applyTracked(monitors.monitorRuleDesc(name), monitors.monitorRuleCode(name), q, name);
            return;
        }
        monitors.applyTracked(monitors.monitorRuleDesc(name), monitors.monitorRuleCode(name), q, name);
    }
    function monitorInSync(name: string, live: var): bool {
        if (!live)
            return false;
        if (monitors.monitorEnabled(name) !== (live.disabled !== true))
            return false;
        if (!monitors.monitorEnabled(name))
            return true;
        if (typeof live.scale !== "number" || Math.abs(live.scale - monitors.monitorScale(name)) > 0.001)
            return false;
        const cfg = monitors.monitorCfg(name);
        if (typeof cfg.res === "string" && cfg.res !== "" && cfg.res !== "preferred") {
            if (cfg.res !== U.liveModeStr(live))
                return false;
        }
        const pos = monitors.monitorPos(name);
        if (pos !== "auto") {
            const pp = U.parsePos(pos);
            if (pp === null)
                return false;
            if (live.x !== pp.x || live.y !== pp.y)
                return false;
        }
        return true;
    }
    function monitorPos(name: string): string {
        const cfg = monitors.monitorCfg(name);
        if (typeof cfg.pos === "string" && U.isValidMonitorPos(cfg.pos))
            return cfg.pos;
        return "auto";
    }
    function effSize(name: string): var {
        const d = monitors.scaleDims(name);
        const s = monitors.monitorScale(name) || 1;
        return {w: Math.max(1, Math.round(d.w / s)), h: Math.max(1, Math.round(d.h / s))};
    }
    function layoutCoords(order: var, axis: string): var {
        const map = {};
        const list = Array.isArray(order) ? order : [];
        if (axis === "column") {
            let y = 0;
            for (const n of list) {
                map[n] = U.fmtPos(0, y);
                y += monitors.effSize(n).h;
            }
        } else {
            let x = 0;
            for (const n of list) {
                map[n] = U.fmtPos(x, 0);
                x += monitors.effSize(n).w;
            }
        }
        return map;
    }
    function setMonitorLayout(map: var): void {
        const names = map ? Object.keys(map) : [];
        if (names.length === 0)
            return;
        const targets = [];
        for (const n of names) {
            if (monitors.monitorLive(n) === null)
                continue;
            if (typeof map[n] !== "string" || monitors.monitorPos(n) === map[n])
                continue;
            monitors.putMonitorCfg(n, {pos: map[n]});
            targets.push(n);
        }
        if (targets.length === 0)
            return;
        monitors.applyMonitorRules(targets, targets.join(", ") + " arranged");
        Settings.scheduleSave();
    }
    function layoutAxis(): string {
        const live = monitors.enabledMonitors();
        if (live.length < 2)
            return "row";
        let minX = 1e9, maxX = -1e9, minY = 1e9, maxY = -1e9;
        for (const m of live) {
            const x = m.x ?? 0, y = m.y ?? 0;
            if (x < minX)
                minX = x;
            if (x > maxX)
                maxX = x;
            if (y < minY)
                minY = y;
            if (y > maxY)
                maxY = y;
        }
        return (maxY - minY) > (maxX - minX) ? "column" : "row";
    }
    function reflowPositions(): var {
        const enabled = monitors.enabledMonitors().filter(m => m && monitors.monitorLive(m.name) !== null);
        if (enabled.length < 2)
            return {moved: [], map: {}};
        const axis = monitors.layoutAxis();
        const byAxis = axis === "column" ? (a, b) => (a.y ?? 0) - (b.y ?? 0) : (a, b) => (a.x ?? 0) - (b.x ?? 0);
        const order = enabled.slice().sort(byAxis).map(m => String(m.name));
        const map = monitors.layoutCoords(order, axis);
        const moved = [];
        for (const n of order) {
            if (typeof map[n] !== "string" || monitors.monitorPos(n) === map[n])
                continue;
            monitors.putMonitorCfg(n, {pos: map[n]});
            moved.push(n);
        }
        return {moved: moved, map: map};
    }
    function applyMonitorRules(names: var, label: string): var {
        const seen = {};
        const list = [];
        for (const n of (Array.isArray(names) ? names : [])) {
            if (typeof n !== "string" || n === "" || seen[n])
                continue;
            seen[n] = true;
            list.push(n);
        }
        if (list.length === 0)
            return [];
        const coords = list.map(n => ({n: n, p: U.parsePos(monitors.monitorPos(n)) ?? {x: 0, y: 0}}));
        coords.sort((a, b) => a.p.x - b.p.x || a.p.y - b.p.y);
        const ordered = coords.map(c => c.n);
        monitors.applyBatched(label !== "" ? label : ordered.join(", ") + " arranged", ordered.map(n => monitors.monitorRuleCode(n)), false, ordered);
        return ordered;
    }
    function applyWithReflow(name: string, changed: bool): void {
        const moved = monitors.reflowPositions().moved;
        if (!changed && moved.length === 0) {
            monitors.applyMonitor(name);
        } else if (moved.length === 0) {
            monitors.applyMonitorRules([name], monitors.monitorRuleDesc(name));
        } else {
            const targets = moved.includes(name) ? moved : [...moved, name];
            monitors.applyMonitorRules(targets, targets.join(", ") + " arranged");
        }
        Settings.scheduleSave();
    }
    function revertCfgToLive(name: string): void {
        const live = monitors.monitorLive(name);
        if (!live)
            return;
        const patch = {};
        patch.enabled = live.disabled !== true;
        if (typeof live.scale === "number" && !isNaN(live.scale))
            patch.scale = Math.max(0.5, Math.min(3, live.scale));
        const mode = U.liveModeStr(live);
        if (mode !== "")
            patch.res = mode;
        if (typeof live.x === "number" && typeof live.y === "number")
            patch.pos = U.fmtPos(live.x, live.y);
        monitors.putMonitorCfg(name, patch);
        Settings.scheduleSave();
    }
    function applyTracked(label: string, code: string, quiet: bool, key: string): void {
        const k = typeof key === "string" && key !== "" ? key : label;
        monitors.applyQueue = [...monitors.applyQueue.filter(j => j.key !== k), {label: label, code: code, quiet: !!quiet, key: k}];
        if (monitors.applyQueue.length > 20)
            monitors.applyQueue = monitors.applyQueue.slice(monitors.applyQueue.length - 20);
        monitors.pumpApply();
    }
    function applyBatched(label: string, codes: var, quiet: bool, keys: var): void {
        const list = Array.isArray(codes) ? codes.slice() : [];
        const names = Array.isArray(keys) ? keys.slice() : [];
        if (list.length === 0 || names.length === 0)
            return;
        const k = names.join(",");
        monitors.applyQueue = [...monitors.applyQueue.filter(j => j.key !== k), {label: label, codes: list, quiet: !!quiet, key: k, batch: true}];
        if (monitors.applyQueue.length > 20)
            monitors.applyQueue = monitors.applyQueue.slice(monitors.applyQueue.length - 20);
        monitors.pumpApply();
    }
    function pumpApply(): void {
        if (monApply.running || monitors.applyQueue.length === 0)
            return;
        const job = monitors.applyQueue[0];
        monitors.applyQueue = monitors.applyQueue.slice(1);
        monApply.jobLabel = job.label;
        monApply.jobQuiet = job.quiet;
        monApply.jobKey = job.key;
        monApply.jobBatch = job.batch === true;
        if (monApply.jobBatch)
            monApply.command = ["hyprctl", "--batch", job.codes.map(c => "eval " + c).join(" ; ")];
        else
            monApply.command = ["hyprctl", "eval", job.code];
        monApply.running = true;
        applyTimeout.restart();
    }
    function putMonitorCfg(name: string, patch: var): void {
        if (!monitors.validMonitorName(name))
            return;
        const cfgs = Object.assign({}, monitors.monitorConfigs);
        cfgs[name] = Object.assign({}, monitors.monitorCfg(name), patch);
        monitors.monitorConfigs = cfgs;
    }
    function scaleDims(name: string): var {
        const cfg = monitors.monitorCfg(name);
        if (cfg && typeof cfg.res === "string" && cfg.res !== "" && cfg.res !== "preferred") {
            const p = U.parseMode(cfg.res);
            if (p.valid && p.w > 0 && p.h > 0)
                return {w: p.w, h: p.h};
        }
        const live = monitors.monitorLive(name);
        return {w: live && typeof live.width === "number" ? live.width : 1920, h: live && typeof live.height === "number" ? live.height : 1080};
    }
    function setMonitorScale(name: string, v: real): void {
        const d = monitors.scaleDims(name);
        const snapped = U.nearestValidScale(d.w, d.h, Math.max(0.5, Math.min(3, v)));
        const rounded = Math.round(snapped * 20) / 20;
        const prev = monitors.monitorScale(name);
        monitors.putMonitorCfg(name, {scale: rounded});
        monitors.applyWithReflow(name, rounded !== prev);
    }
    function cycleValidScale(name: string, dir: int): void {
        if (typeof name !== "string" || name === "")
            return;
        const d = monitors.scaleDims(name);
        monitors.setMonitorScale(name, U.nextValidScale(d.w, d.h, monitors.monitorScale(name), dir));
    }
    function setMonitorEnabled(name: string, on: bool): void {
        if (!on && !monitors.canDisableMonitor(name)) {
            monitors.lastApplyMsg = "Cannot disable " + name + " (only display)";
            return;
        }
        monitors.putMonitorCfg(name, {enabled: on});
        if (!on && monitors.mainMonitor === name)
            monitors.mainMonitor = "auto";
        monitors.applyWithReflow(name, true);
    }
    function setMonitorRes(name: string, res: string): void {
        const prevRes = monitors.monitorRes(name);
        monitors.putMonitorCfg(name, {res: res});
        monitors.applyWithReflow(name, prevRes !== res);
    }
    function setMonitorResolution(name: string, resKey: string): void {
        if (typeof name !== "string" || name === "")
            return;
        if (resKey === "Preferred") {
            monitors.setMonitorRes(name, "preferred");
            return;
        }
        const fulls = U.ratesForMode(monitors.monitorModes(name), resKey);
        if (fulls.length === 0) {
            monitors.lastApplyMsg = "No mode for " + resKey + " on " + name;
            return;
        }
        monitors.setMonitorRes(name, fulls[0]);
    }
    function cycleMonitorResolution(name: string, dir: int): void {
        const opts = monitors.monitorResolutions(name);
        monitors.setMonitorResolution(name, U.cycleOpt(opts, monitors.monitorResKey(name), dir));
    }

    function mainMonitorOptions(): var {
        const names = monitors.enabledMonitors().map(m => String(m && m.name ? m.name : "")).filter(n => n !== "");
        return ["auto"].concat(names);
    }
    function setMainMonitor(name: string): void {
        let next = (typeof name === "string" && name !== "") ? name : "auto";
        if (next !== "auto" && monitors.monitorsReady) {
            const live = monitors.monitorLive(next);
            if (!live || !monitors.monitorEnabled(next))
                next = "auto";
        }
        monitors.mainMonitor = next;
        Settings.scheduleSave();
    }
    function mainScreen(screens, focusedName): var {
        const list = screens ?? [];
        const want = monitors.mainMonitor;
        if (typeof want === "string" && want !== "" && want !== "auto" && monitors.monitorEnabled(want)) {
            const hit = list.find(s => s && s.name === want);
            if (hit)
                return hit;
        }
        return list.length > 0 ? list[0] : null;
    }
    function popupScreen(screens, focusedName): var {
        const list = screens ?? [];
        if (typeof focusedName === "string" && focusedName !== "") {
            const fhit = list.find(s => s && s.name === focusedName);
            if (fhit)
                return fhit;
        }
        return monitors.mainScreen(list, focusedName);
    }

    Process {
        id: monitorScan
        property bool dropNextExit: false
        command: ["hyprctl", "monitors", "all", "-j"]
        onRunningChanged: {
            if (monitorScan.running)
                monScanTimeout.restart();
            else
                monScanTimeout.stop();
        }
        stdout: StdioCollector {
            onStreamFinished: {
                if (monitorScan.dropNextExit)
                    return;
                try {
                    if (text.length > 1048576)
                        throw "monitors output too large";
                    const arr = JSON.parse(text);
                    monitors.monitors = Array.isArray(arr) ? arr : [];
                } catch (_) {
                    monitors.monitors = [];
                }
                const live = {};
                for (const m of monitors.monitors) {
                    if (m && typeof m.name === "string" && m.name !== "")
                        live[m.name] = true;
                }
                monitors.appliedMonitors = monitors.appliedMonitors.filter(n => live[n]);
                if (monitors.monitors.length > 0 && monitors.mainMonitor !== "auto" && (!live[monitors.mainMonitor] || !monitors.monitorEnabled(monitors.mainMonitor))) {
                    monitors.mainMonitor = "auto";
                    Settings.scheduleSave();
                }
                monitors.monitorsReady = true;
                monitors.applyScannedMonitors();
            }
        }
        onExited: exitCode => {
            if (monitorScan.dropNextExit) {
                monitorScan.dropNextExit = false;
                return;
            }
            if (exitCode !== 0) {
                monitors.monitors = [];
                monitors.monitorsReady = true;
                monitors.applyScannedMonitors();
            }
        }
        Component.onCompleted: monitorScan.running = true
    }
    Timer {
        id: monScanTimeout
        interval: 10000
        repeat: false
        onTriggered: {
            if (monitorScan.running) {
                monitorScan.dropNextExit = true;
                monitorScan.running = false;
                console.warn("quickshell: hyprctl monitors timed out, using cached state");
                monitors.monitors = [];
                monitors.monitorsReady = true;
                monitors.applyScannedMonitors();
            }
        }
    }
    Process {
        id: monApply
        property string jobLabel: ""
        property bool jobQuiet: false
        property string jobKey: ""
        property bool jobBatch: false
        property bool dropNextExit: false
        stdout: StdioCollector {
            id: monOut
        }
        stderr: StdioCollector {
            id: monErr
        }
        onExited: exitCode => {
            if (monApply.dropNextExit) {
                monApply.dropNextExit = false;
                monitors.pumpApply();
                return;
            }
            applyTimeout.stop();
            const detail = (monErr.text + " " + monOut.text).trim();
            const failed = exitCode !== 0;
            if (!failed) {
                monitors.lastApplyMsg = monApply.jobLabel + " applied";
            } else {
                monitors.lastApplyMsg = "Failed: " + monApply.jobLabel + (detail !== "" ? " (" + detail.slice(0, 120) + ")" : "");
                const keys = monApply.jobBatch ? String(monApply.jobKey ?? "").split(",").filter(k => k !== "") : [monApply.jobKey];
                let reverted = false;
                for (const key of keys) {
                    if (typeof key === "string" && key !== "" && monitors.monitorLive(key) !== null) {
                        monitors.revertCfgToLive(key);
                        reverted = true;
                    }
                }
                if (reverted) {
                    monitors.refreshMonitors(true);
                    Notifs.notify({app: "settings", summary: "Display change reverted", body: monApply.jobLabel + " was rejected; restored last working mode.", syncId: "display-revert", timeout: 8000});
                }
            }
            monitors.pumpApply();
            if (!monApply.running)
                monitors.refreshMonitors(true);
        }
    }
    Timer {
        id: applyTimeout
        interval: 10000
        repeat: false
        onTriggered: {
            if (monApply.running) {
                monApply.running = false;
                monApply.dropNextExit = true;
                monitors.lastApplyMsg = "Timed out: " + monApply.jobLabel;
            }
        }
    }
}
