# Vague theme for btop
# Colors from the Vague GTK/terminal palette.

# Main background, empty for terminal default
theme[main_bg]="#141415"

# Main text color
theme[main_fg]="#cdcdcd"

# Title color for boxes
theme[title]="#cdcdcd"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7e98e8"

# Background color of selected item in processes box
theme[selected_bg]="#7e98e8"

# Foreground color of selected item in processes box
theme[selected_fg]="#141415"

# Color of inactive/disabled text
theme[inactive_fg]="#606079"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#6e94b2"

# Cpu box outline color
theme[cpu_box]="#333738"

# Memory/disks box outline color
theme[mem_box]="#333738"

# Net up/down box outline color
theme[net_box]="#333738"

# Processes box outline color
theme[proc_box]="#333738"

# Box divider line and small boxes line color
theme[div_line]="#252530"

# Temperature graph colors
theme[temp_start]="#7e98e8"
theme[temp_mid]="#e0a363"
theme[temp_end]="#d8647e"

# CPU graph colors
theme[cpu_start]="#7e98e8"
theme[cpu_mid]="#bb9dbd"
theme[cpu_end]="#d8647e"

# Mem/Disk free meter
theme[free_start]="#a6d189"
theme[free_mid]="#7e98e8"
theme[free_end]="#f3be7c"

# Mem/Disk cached meter
theme[cached_start]="#6e94b2"
theme[cached_mid]="#90a0b5"
theme[cached_end]="#bb9dbd"

# Mem/Disk available meter
theme[available_start]="#a6d189"
theme[available_mid]="#9bb4bc"
theme[available_end]="#e0a363"

# Mem/Disk used meter
theme[used_start]="#7e98e8"
theme[used_mid]="#bb9dbd"
theme[used_end]="#d8647e"

# Download graph colors
theme[download_start]="#a6d189"
theme[download_mid]="#9bb4bc"
theme[download_end]="#e0a363"

# Upload graph colors
theme[upload_start]="#7e98e8"
theme[upload_mid]="#bb9dbd"
theme[upload_end]="#d8647e"
