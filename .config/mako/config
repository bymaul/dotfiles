font=JetBrainsMono Nerd Font Mono 10
background-color=#141415b3
text-color=#cdcdcd
border-color=#cdcdcd66
border-size=1
border-radius=0
width=300
height=90
padding=8
margin=8
max-visible=5
default-timeout=5000
icons=1
icon-path=/usr/share/icons/Adwaita
layer=overlay
anchor=top-right
group-by=app-name
sort=-time

[app-name=volume]
progress-color=over #cdcdcd33

[app-name=brightness]
progress-color=over #cdcdcd33
