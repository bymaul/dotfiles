{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["bluetooth", "network", "pulseaudio", "cpu", "memory", "battery", "tray", "group/modes", "custom/power"],

  "hyprland/workspaces": {
    "format": "{id}",
    "sort-by": "number"
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 30
  },

  "clock": {
    "interval": 60,
    "format": "{:%H:%M  %a %d %b}",
    "tooltip": true,
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#cdcdcd'><b>{}</b></span>",
        "weekdays": "<span color='#606079'>{}</span>",
        "days": "<span color='#cdcdcd'>{}</span>",
        "today": "<span color='#141415' background='#aeaed1'><b>{}</b></span>"
      }
    }
  },

  "bluetooth": {
    "format-disabled": "",
    "format-on": "󰂯",
    "format-connected": "󰂱 {num_connections}",
    "format-no-controller": "",
    "on-click": "kitty --class bluetui bluetui",
    "tooltip-format": "{controller_alias}  {controller_address}",
    "tooltip-format-connected": "{controller_alias}  {controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-disabled": "bluetooth disabled"
  },

  "cpu": {
    "interval": 2,
    "format": "{usage}%",
    "max-length": 8,
    "on-click": "kitty --class btop btop"
  },

  "memory": {
    "interval": 5,
    "format": "{used:0.1f}G",
    "max-length": 8,
    "on-click": "kitty --class btop btop"
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 MUT",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "/home/maul/.local/bin/osd-volume mute",
    "on-scroll-up": "/home/maul/.local/bin/osd-volume up",
    "on-scroll-down": "/home/maul/.local/bin/osd-volume down"
  },

  "network": {
    "format-wifi": "󰖩 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid}: {ipaddr}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}",
    "tooltip-format-disconnected": "no connection",
    "on-click": "kitty --class wifitui wifitui"
  },

  "battery": {
    "interval": 30,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-full": "{icon} {capacity}%",
    "format-icons": {
      "default": ["", "", "", "", ""],
      "charging": ""
    },
    "on-click": "xfce4-power-manager-settings"
  },

  "group/modes": {
    "orientation": "horizontal",
    "modules": ["custom/caffeine", "custom/dnd"]
  },

  "custom/caffeine": {
    "format": "{}",
    "interval": 2,
    "exec": "/home/maul/.local/bin/caffeine-status",
    "on-click": "/home/maul/.local/bin/caffeine-toggle",
    "signal": 8,
    "tooltip": false
  },

  "custom/dnd": {
    "format": "{}",
    "interval": 2,
    "exec": "/home/maul/.local/bin/dnd-status",
    "on-click": "/home/maul/.local/bin/dnd-toggle",
    "signal": 9,
    "tooltip": false
  },

  "custom/power": {
    "format": "",
    "on-click": "wleave",
    "tooltip": false
  },

  "tray": {
    "spacing": 6
  }
}
