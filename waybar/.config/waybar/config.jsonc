{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["bluetooth", "network", "pulseaudio", "cpu", "memory", "battery", "tray", "custom/power"],

  "hyprland/workspaces": {
    "format": "{id}",
    "sort-by": "number"
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 60
  },

  "clock": {
    "interval": 60,
    "format": "{:%H:%M  %a %d %b}",
    "tooltip": true,
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#ffffff'><b>{}</b></span>",
        "weekdays": "<span color='#999999'>{}</span>",
        "days": "<span color='#ffffff'>{}</span>",
        "today": "<span color='#000000' background='#ffffff'><b>{}</b></span>"
      }
    }
  },

  "bluetooth": {
    "format-disabled": "",
    "format-on": "\uf294",
    "format-connected": "\uf294 {num_connections}",
    "format-no-controller": "",
    "on-click": "kitty --class bluetui bluetui",
    "tooltip-format": "{controller_alias}  {controller_address}",
    "tooltip-format-connected": "{controller_alias}  {controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-disabled": "bluetooth disabled"
  },

  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "max-length": 8,
    "on-click": "kitty --class htop htop"
  },

  "memory": {
    "interval": 5,
    "format": " {used:0.1f}G",
    "max-length": 8,
    "on-click": "kitty --class btop btop"
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "{icon} MUT",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": " eth",
    "format-disconnected": "",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "kitty --class nmtui nmtui"
  },

  "battery": {
    "interval": 30,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-full": "{icon} {capacity}%",
    "format-icons": {
      "default": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
      "charging": "\uf0e7"
    },
    "on-click": "xfce4-power-manager-settings"
  },

  "custom/power": {
    "format": "\uf011",
    "on-click": "wleave",
    "tooltip": false
  },

  "tray": {
    "spacing": 6
  }
}
