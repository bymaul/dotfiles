#!/usr/bin/env bash
set -euo pipefail

CONF=/etc/systemd/logind.conf.d/10-quickshell.conf
SETTINGS="${XDG_DATA_HOME:-$HOME/.local/share}/quickshell/settings.json"

get() {
    if command -v jq >/dev/null 2>&1 && [ -f "$SETTINGS" ]; then
        jq -r --arg k "$1" --arg d "$2" '.[$k] // $d' "$SETTINGS" 2>/dev/null || printf '%s' "$2"
    else
        printf '%s' "$2"
    fi
}

map_val() {
    case "$1" in
        lock) printf 'lock' ;;
        poweroff) printf 'poweroff' ;;
        ignore | menu | notify) printf 'ignore' ;;
        *) printf 'suspend' ;;
    esac
}

mode="${1:-}"
if [ "$mode" = "--install" ]; then
    # root mode (via pkexec): explicit value, caller is already root
    if [ "$(id -u)" -ne 0 ]; then
        echo "qs-power-logind --install must run as root (pkexec qs-power-logind --install <action>)" >&2
        exit 1
    fi
    lid="${2:-suspend}"
else
    lid=$(get lidCloseAction suspend)
fi

content=$(
    printf '# generated by qs-power-logind - do not edit, change it in the qs settings popup\n'
    printf '[Login]\n'
    printf 'HandleLidSwitch=%s\n' "$(map_val "$lid")"
    printf 'HandleLidSwitchExternalPower=%s\n' "$(map_val "$lid")"
    printf 'HandleLidSwitchDocked=%s\n' "$(map_val "$lid")"
    printf 'HandlePowerKey=ignore\n'
)

if [ "$mode" = "--install" ]; then
    mkdir -p "$(dirname "$CONF")"
    printf '%s\n' "$content" >"$CONF"
    echo "installed $CONF (reboot to apply; restarting logind would end your session)"
elif [ "$mode" = "--apply" ]; then
    sudo mkdir -p "$(dirname "$CONF")"
    echo "$content" | sudo tee "$CONF" >/dev/null
    echo "installed $CONF (reboot to apply; restarting logind would end your session)"
else
    echo "$content"
    echo "# run 'qs-power-logind --apply' to install (reboot to apply)"
fi

if systemd-inhibit --list --no-legend 2>/dev/null | grep -qi xfce; then
    echo "# WARNING: xfce4-power-manager is running and blocks logind lid/power handling." >&2
    echo "# uninstall it: sudo pacman -Rns xfce4-power-manager && pkill xfce4-power-manager" >&2
fi
