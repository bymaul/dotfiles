#!/bin/bash
# Screenshot: saves a timestamped PNG to ~/Pictures/Screenshots and copies
# it to the clipboard, then notifies. The quickshell toast handles the
# Open/Copy path actions natively (via the filepath hint), so this stays
# fire-and-forget with no --wait blocking.
# Usage: screenshot [area|full|window]
# Cancelling the selection produces no file and no notification.

mode="${1:-area}"
dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

case "$mode" in
    full)
        grim - | tee "$file" | wl-copy -t image/png
        ;;
    window)
        geom=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
        grim -g "$geom" - | tee "$file" | wl-copy -t image/png
        ;;
    *) # area
        grim -g "$(slurp -d)" - | tee "$file" | wl-copy -t image/png
        ;;
esac

if [ -s "$file" ]; then
    notify-send -a screenshot -h string:x-canonical-private-synchronous:screenshot -h string:filepath:"$file" -t 10000 -i "$file" \
        -A "default=Open" -A "path=Copy path" "Screenshot" "$(basename "$file")"
else
    rm -f "$file"
fi
