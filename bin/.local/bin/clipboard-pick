#!/usr/bin/env sh
# cliphist history manager (SUPER+V).
# Usage: clipboard-pick [paste|delete|clear]
#   paste   (default) pick an item; copies it to the clipboard, then
#           auto-pastes (Win+V style) into the window focused when the
#           picker opened (Ctrl+Shift+V for terminals, Ctrl+V otherwise).
#   delete  pick an item to remove from history.
#   clear   wipe the whole history (asks for confirmation first).
# Hardened against rofi 2.0:
#   - bails if another rofi instance is already open (double-tap SUPER+V,
#     app launcher, ...) so a concurrent rofi can never poison the pipeline.
#   - filters rofi stdout to real cliphist "id<TAB>preview" lines.
# Depends on: cliphist, rofi, wl-clipboard, jq

# another rofi is up -> do nothing instead of stacking a second instance
pgrep -x rofi >/dev/null 2>&1 && exit 0

mode="${1:-paste}"

# remember the window focused *before* the picker opens so the paste always
# lands there, even if focus shuffles while rofi is on screen
winaddr="$(hyprctl activewindow -j 2>/dev/null | jq -r '.address' 2>/dev/null)"
winclass="$(hyprctl activewindow -j 2>/dev/null | jq -r '.class' 2>/dev/null | tr '[:upper:]' '[:lower:]')"

# clear: confirm, then wipe everything
if [ "$mode" = "clear" ]; then
	ans="$(printf 'No\nYes' | rofi -dmenu -p 'Wipe clipboard history?' -no-custom 2>/dev/null | head -1)"
	[ "$ans" = "Yes" ] && cliphist wipe
	exit 0
fi

# picker: run rofi against a snapshot of the history so selection/deletion
# never races with new clipboard writes
list="$(mktemp)"
out="$(mktemp)"
trap 'rm -f "$list" "$out"' EXIT HUP INT TERM

cliphist list > "$list" || exit 0
[ -s "$list" ] || exit 0

rofi -dmenu -display-columns 2 -no-sort -sync < "$list" > "$out" 2>/dev/null
[ -s "$out" ] || exit 0

selection="$(awk -v FS='\t' 'NF > 1 { print; exit }' "$out")"
[ -n "$selection" ] || exit 0

case "$mode" in
	delete)
		printf '%s\n' "$selection" | cliphist delete
		;;
	*) # paste
		printf '%s\n' "$selection" | cliphist decode | wl-copy

		# terminals usually don't bind plain Ctrl+V to paste (kitty, foot,
		# alacritty, ... use Ctrl+Shift+V); GUI apps paste on Ctrl+V
		case "$winclass" in
			*kitty* | *alacritty* | *foot* | *wezterm* | *ghostty* | *konsole* | *gnome-terminal* | *xfce4-terminal* | *terminator* | *tilix* | *xterm* | *rxvt* | *hyper* | *tabby* | *stterm* | st)
				mods='CTRL, SHIFT'
				;;
			*)
				mods='CTRL'
				;;
		esac

		# let rofi finish closing and the copy settle, then paste into the
		# window that was focused when the picker opened
		i=0
		while pgrep -x rofi >/dev/null 2>&1 && [ "$i" -lt 40 ]; do
			sleep 0.05
			i=$((i + 1))
		done
		sleep 0.1

		# quoted strings are required: `mods = CTRL` would evaluate CTRL as a
		# (nil) Lua global. the window selector pins the paste target.
		if [ -n "$winaddr" ]; then
			hyprctl dispatch "hl.dsp.send_shortcut({ mods = \"$mods\", key = \"V\", window = \"address:$winaddr\" })" >/dev/null 2>&1
		else
			hyprctl dispatch "hl.dsp.send_shortcut({ mods = \"$mods\", key = \"V\" })" >/dev/null 2>&1
		fi
		;;
esac
